#!/bin/sh
#
# Runs the test suite before every push, enforcing the rule in CLAUDE.md:
# never push code whose tests have not run and passed. costs/ works out money
# that changes hands at a club night, so a wrong number is worse than a late one.
#
# Enabled once per clone with:
#   git config core.hooksPath .githooks
#
# Deliberate bypass, for a README typo when you know what you are doing:
#   git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node was not found, so the tests cannot run." >&2
  echo "pre-push: install Node, or push with --no-verify if you are sure." >&2
  exit 1
fi

echo "pre-push: running node --test"

# stdin carries the refs being pushed; keep it away from the test runner.
if node --test </dev/null; then
  echo "pre-push: tests passed, pushing."
  exit 0
fi

echo "" >&2
echo "pre-push: TESTS FAILED, push aborted." >&2
echo "pre-push: fix them, or use --no-verify if you are certain." >&2
exit 1
